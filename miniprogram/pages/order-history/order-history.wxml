<!-- pages/order-history/order-history.wxml -->
<view class="container order-history-container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <!-- 无权限提示 -->
  <view wx:elif="{{!canViewOrders}}" class="empty-state">
    <view class="empty-icon">🔒</view>
    <view class="empty-text">您暂无查看投喂任务的权限</view>
    <view class="empty-hint">请联系管理员升级您的账号权限</view>
  </view>

  <view wx:elif="{{groupedOrders.length === 0}}" class="empty-state">
    <view class="empty-icon">📋</view>
    <view class="empty-text">暂无投喂任务</view>
  </view>

  <view wx:else class="order-list">
    <!-- 按聚餐日分组显示 -->
    <view wx:for="{{groupedOrders}}" wx:key="gatheringDayDate" wx:for-item="group" class="gathering-group">
      <!-- 聚餐日横幅 - 根据时间添加样式类 -->
      <view class="gathering-banner {{group.timeStatus}}">
        <view class="gathering-banner-left">
          <view class="gathering-icon">🎉</view>
          <view class="gathering-info">
            <view class="gathering-theme">{{group.displayTitle}}</view>
            <view class="gathering-date">{{group.displaySubtitle}}</view>
          </view>
        </view>
        <view class="gathering-count">{{group.orders.length}} 个任务</view>
      </view>

      <!-- 该聚餐日下的订单列表 -->
      <view class="group-orders">
        <view wx:for="{{group.orders}}" wx:key="_id" wx:for-item="item" class="order-card">
          <!-- 订单头部 - 用户信息 -->
          <view class="order-user-info">
            <image wx:if="{{item.userAvatar}}" class="user-avatar" src="{{item.userAvatar}}" mode="aspectFill"></image>
            <view wx:else class="user-avatar-placeholder">{{item.userName ? item.userName.charAt(0) : '?'}}</view>
            <view class="user-name">{{item.userName || '匿名用户'}}</view>
          </view>

          <!-- 任务时间和状态 -->
          <view class="order-header">
            <view class="order-time">召唤时间：{{item.createTimeFormatted}}</view>
            <view class="order-status {{item.status}}">{{item.statusText}}</view>
          </view>

          <!-- 投喂菜品列表 -->
          <view class="order-dishes">
            <view wx:for="{{item.dishes}}" wx:key="dishId" wx:for-item="dish" class="dish-item">
              <view class="dish-name">{{dish.name}}</view>
              <view class="dish-count">x{{dish.count}}</view>
            </view>
          </view>

          <!-- 投喂备注 -->
          <view wx:if="{{item.notes}}" class="order-notes">
            <view class="notes-label">备注：</view>
            <view class="notes-text">{{item.notes}}</view>
          </view>

          <!-- 操作按钮（仅自己的任务显示） -->
          <view wx:if="{{item.isMyOrder}}" class="order-actions">
            <!-- 只有今天及以后的任务才显示编辑按钮 -->
            <button wx:if="{{!item.isPastOrder}}" class="edit-btn" bindtap="editOrder" data-order="{{item}}">
              编辑投喂任务
            </button>
            <button class="delete-btn" bindtap="deleteOrder" data-id="{{item._id}}">
              删除投喂任务
            </button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
