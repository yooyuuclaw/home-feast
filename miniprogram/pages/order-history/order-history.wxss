/* pages/order-history/order-history.wxss */
.order-history-container {
  padding: 20rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  animation: fadeIn var(--transition-normal);
}

.empty-icon {
  font-size: 150rpx;
  text-align: center;
  margin-bottom: 30rpx;
  opacity: 0.3;
  animation: breathe 3s ease-in-out infinite;
}

.empty-text {
  font-size: 32rpx;
  color: var(--color-text-gray);
  margin-bottom: 15rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #BBB;
  text-align: center;
  line-height: 1.6;
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

/* 聚餐日分组 */
.gathering-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  animation: slideUp var(--transition-normal);
}

/* 聚餐日横幅 - 根据时间个性化 */
.gathering-banner {
  border-radius: var(--radius-lg);
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
  transition: all var(--transition-normal);
}

/* 默认样式（未来的聚餐） */
.gathering-banner {
  background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
}

/* 今天的聚餐 - 金色高光 */
.gathering-banner.today {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FF8C00 100%);
  box-shadow: 0 6rpx 24rpx rgba(255, 165, 0, 0.4);
  animation: gentle-pulse 2s ease-in-out infinite;
}

.gathering-banner.today::after {
  content: '⚡';
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 48rpx;
  opacity: 0.6;
  animation: rotate 4s linear infinite;
}

/* 即将到来的聚餐（明天/后天） - 亮色期待风格 */
.gathering-banner.upcoming {
  background: linear-gradient(135deg, #FFB74D 0%, #FFA726 100%);
}

/* 已过去的聚餐 - 灰色怀旧风格 */
.gathering-banner.past {
  background: linear-gradient(135deg, #BDBDBD 0%, #9E9E9E 100%);
  opacity: 0.85;
}

.gathering-banner.past::before {
  content: '📅';
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 48rpx;
  opacity: 0.3;
}

/* 装饰性背景图案 */
.gathering-banner::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(circle at 15% 25%, rgba(255, 255, 255, 0.3) 6rpx, transparent 6rpx),
    radial-gradient(circle at 75% 65%, rgba(255, 255, 255, 0.25) 8rpx, transparent 8rpx),
    radial-gradient(circle at 45% 85%, rgba(255, 255, 255, 0.3) 5rpx, transparent 5rpx),
    radial-gradient(circle at 85% 30%, rgba(255, 255, 255, 0.25) 7rpx, transparent 7rpx);
  background-size: 180rpx 180rpx;
  pointer-events: none;
  opacity: 0.6;
}

.gathering-banner-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  position: relative;
  z-index: 1;
}

.gathering-icon {
  font-size: 68rpx;
  line-height: 1;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.15));
  animation: breathe 3s ease-in-out infinite;
}

.gathering-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.gathering-theme {
  font-size: 34rpx;
  font-weight: bold;
  color: white;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 1rpx;
}

.gathering-date {
  font-size: 26rpx;
  color: white;
  opacity: 0.95;
  font-weight: 500;
}

.gathering-count {
  font-size: 24rpx;
  color: white;
  background: rgba(255, 255, 255, 0.3);
  padding: 10rpx 18rpx;
  border-radius: 20rpx;
  font-weight: bold;
  position: relative;
  z-index: 1;
  backdrop-filter: blur(5rpx);
}

/* 分组内的订单列表 */
.group-orders {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  background: var(--color-bg-light);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-md);
  transition: all var(--transition-fast);
  animation: fadeIn var(--transition-normal);
}

.order-card:active {
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-lg);
}

/* 用户信息 */
.order-user-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid var(--color-bg);
}

.order-user-info .user-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: var(--radius-full);
  margin-right: 18rpx;
  background: var(--color-bg-gray);
  border: 3rpx solid var(--color-primary-light);
  box-shadow: var(--shadow-sm);
}

.order-user-info .user-avatar-placeholder {
  width: 68rpx;
  height: 68rpx;
  border-radius: var(--radius-full);
  margin-right: 18rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-primary-darker);
  flex-shrink: 0;
  border: 3rpx solid var(--color-primary-light);
  box-shadow: var(--shadow-sm);
}

.order-user-info .user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-primary-darker);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid var(--color-bg);
}

.order-time {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.order-status {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: var(--shadow-sm);
}

.order-status.pending {
  background: #fff7e6;
  color: var(--color-warning);
  border: 2rpx solid #ffe7ba;
}

.order-status.confirmed {
  background: #e6f7ff;
  color: var(--color-info);
  border: 2rpx solid #bae7ff;
}

.order-status.completed {
  background: #f6ffed;
  color: var(--color-success);
  border: 2rpx solid #d9f7be;
}

/* 订单菜品 - 视觉化升级 */
.order-dishes {
  margin-bottom: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.dish-item {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, var(--color-primary-lighter) 0%, #FFE6CC 100%);
  border: 2rpx solid var(--color-primary);
  border-radius: 24rpx;
  padding: 12rpx 24rpx;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-fast);
  position: relative;
  overflow: hidden;
}

/* 菜品卡片闪光效果 */
.dish-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  transition: left var(--transition-slow);
}

.dish-item:active::before {
  left: 100%;
}

.dish-item:active {
  transform: scale(0.96);
}

.dish-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--color-primary-darker);
}

.dish-count {
  font-size: 24rpx;
  font-weight: bold;
  color: #ff9a56;
  background: white;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  min-width: 48rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
}

/* 订单备注 */
.order-notes {
  background: var(--color-bg-gray);
  border-radius: var(--radius-sm);
  padding: 18rpx;
  font-size: 26rpx;
  border: 2rpx solid var(--color-border);
}

.notes-label {
  color: var(--color-text-secondary);
  margin-bottom: 6rpx;
  font-weight: 500;
}

.notes-text {
  color: var(--color-text-primary);
  line-height: 1.5;
}

/* 订单操作 */
.order-actions {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--color-bg);
  display: flex;
  justify-content: flex-end;
}

.delete-btn {
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  color: var(--color-error);
  background: white;
  border: 2rpx solid var(--color-error);
  border-radius: var(--radius-sm);
  line-height: normal;
  transition: all var(--transition-fast);
  font-weight: bold;
}

.delete-btn:active {
  background: #fff5f5;
  transform: scale(0.96);
}
