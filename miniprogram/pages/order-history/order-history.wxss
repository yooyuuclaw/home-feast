/* pages/order-history/order-history.wxss */
.order-history-container {
  padding: 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 150rpx;
  text-align: center;
  margin-bottom: 30rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 15rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #BBB;
  text-align: center;
  line-height: 1.6;
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

/* 聚餐日分组 */
.gathering-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 聚餐日横幅 */
.gathering-banner {
  background: linear-gradient(135deg, #E6C8A0 0%, #D4B080 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(139, 110, 78, 0.15);
}

.gathering-banner-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.gathering-icon {
  font-size: 60rpx;
  line-height: 1;
}

.gathering-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.gathering-theme {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B6E4E;
}

.gathering-date {
  font-size: 26rpx;
  color: #8B6E4E;
  opacity: 0.8;
}

.gathering-count {
  font-size: 24rpx;
  color: #8B6E4E;
  background: rgba(255, 255, 255, 0.5);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

/* 分组内的订单列表 */
.group-orders {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 用户信息 */
.order-user-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-user-info .user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 15rpx;
  background: #f5f5f5;
}

.order-user-info .user-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #8B6E4E;
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-time {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.order-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.order-status.pending {
  background: #fff7e6;
  color: #faad14;
}

.order-status.confirmed {
  background: #e6f7ff;
  color: #1890ff;
}

.order-status.completed {
  background: #f6ffed;
  color: #52c41a;
}

/* 订单菜品 */
.order-dishes {
  margin-bottom: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.dish-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #FFF9F0 0%, #FFE6CC 100%);
  border: 2rpx solid #E6C8A0;
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(230, 200, 160, 0.2);
}

.dish-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #8B6E4E;
}

.dish-count {
  font-size: 24rpx;
  font-weight: bold;
  color: #ff9a56;
  background: white;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  min-width: 40rpx;
  text-align: center;
}

/* 订单备注 */
.order-notes {
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 15rpx;
  font-size: 26rpx;
}

.notes-label {
  color: #666;
  margin-bottom: 5rpx;
}

.notes-text {
  color: #333;
}

/* 订单操作 */
.order-actions {
  margin-top: 20rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: flex-end;
}

.delete-btn {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #fa5151;
  background: #fff;
  border: 1rpx solid #fa5151;
  border-radius: 8rpx;
  line-height: normal;
}

.delete-btn:active {
  background: #fff5f5;
}
