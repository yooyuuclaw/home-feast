/* pages/index/index.wxss */
.index-container {
  min-height: 100vh;
  background: #F9F9F9;
  padding: 40rpx 30rpx;
}

/* 欢迎区域 */
.welcome-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 2rpx rgba(238, 238, 238, 0.5);
}

.welcome-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #8B6E4E;
  margin-bottom: 20rpx;
  text-align: center;
}

.welcome-desc {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 1.6;
}

/* 功能卡片 */
.feature-cards {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-bottom: 60rpx;
}

.feature-card {
  background: #E6C8A0;
  border-radius: 20rpx;
  padding: 40rpx;
  border: 1rpx solid #D4B080;
  box-shadow: 0 4rpx 6rpx rgba(212, 176, 128, 0.3);
  transition: all 0.2s ease;
  position: relative;
}

.feature-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 3rpx rgba(212, 176, 128, 0.4);
}

.card-icon {
  font-size: 80rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #8B6E4E;
  text-align: center;
  margin-bottom: 10rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #8B6E4E;
  text-align: center;
  opacity: 0.8;
}

.admin-card {
  background: #FFFFFF;
  border: 1rpx solid #E0E0E0;
}

.admin-card .card-title {
  color: #8B6E4E;
}

.admin-card .card-desc {
  color: #666666;
}

/* 用户信息 */
.user-info-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 2rpx rgba(238, 238, 238, 0.5);
}

.user-info-btn {
  width: 100%;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  text-align: left;
  line-height: normal;
}

.user-info-btn::after {
  border: none;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #F9F9F9;
}

.user-details {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B6E4E;
  margin-bottom: 10rpx;
}

.user-name-input {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B6E4E;
  margin-bottom: 10rpx;
  width: 100%;
  padding: 0;
  background: transparent;
}

.user-role {
  font-size: 26rpx;
  color: #999;
}

.user-info-tip {
  margin-top: 15rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}
