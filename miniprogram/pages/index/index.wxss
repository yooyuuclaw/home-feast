/* pages/index/index.wxss */
.index-container {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 40rpx 30rpx;
}

/* 欢迎区域 - 拼贴相册风格升级版 */
.welcome-section {
  background: linear-gradient(135deg, #FFE0B2 0%, #FFCC80 50%, #FFB74D 100%);
  border-radius: var(--radius-xl);
  padding: 50rpx 30rpx;
  margin-bottom: 40rpx;
  box-shadow: var(--shadow-accent);
  position: relative;
  overflow: hidden;
  min-height: 400rpx;
  animation: slideDown var(--transition-normal);
}

/* 照片拼贴层 */
.photo-collage {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 1;
}

/* 宝丽来相框样式 */
.photo-frame {
  position: absolute;
  background: white;
  padding: 12rpx;
  padding-bottom: 40rpx;
  border-radius: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15), 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all var(--transition-normal);
  animation: fadeIn 0.8s ease-out;
}

.photo-frame:active {
  transform: scale(1.05) !important;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.2);
  z-index: 10 !important;
}

.photo-img {
  width: 160rpx;
  height: 120rpx;
  border-radius: 4rpx;
  display: block;
}

/* 照片1 - 左上角，向左倾斜 */
.photo-1 {
  top: 20rpx;
  left: 20rpx;
  transform: rotate(-12deg);
  z-index: 3;
  animation-delay: 0.1s;
}

/* 照片2 - 右上角，向右倾斜 */
.photo-2 {
  top: 30rpx;
  right: 15rpx;
  transform: rotate(8deg);
  z-index: 2;
  animation-delay: 0.2s;
}

/* 照片3 - 左下角，轻微左倾 */
.photo-3 {
  bottom: 30rpx;
  left: 30rpx;
  transform: rotate(-6deg);
  z-index: 4;
  animation-delay: 0.3s;
}

/* 照片4 - 右下角，向右倾斜 */
.photo-4 {
  bottom: 20rpx;
  right: 25rpx;
  transform: rotate(10deg);
  z-index: 2;
  animation-delay: 0.4s;
}

/* 文字内容层 - 降低透明度并下移 */
.welcome-content {
  position: relative;
  z-index: 5;
  background: rgba(255, 255, 255, 0.40);
  backdrop-filter: blur(20rpx);
  border-radius: var(--radius-lg);
  padding: 30rpx 25rpx;
  margin: 80rpx auto 0;
  max-width: 500rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.welcome-title {
  font-size: 52rpx;
  font-weight: bold;
  color: var(--color-primary-darker);
  margin-bottom: 20rpx;
  text-align: center;
  position: relative;
  z-index: 1;
  letter-spacing: 2rpx;
}

.welcome-desc {
  font-size: 30rpx;
  color: var(--color-primary-darker);
  text-align: center;
  line-height: 1.6;
  position: relative;
  z-index: 1;
  opacity: 0.9;
  font-weight: 500;
}

/* 功能卡片 - 立体化升级 */
.feature-cards {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-bottom: 60rpx;
}

.feature-card {
  background: linear-gradient(135deg, #F5E5D0 0%, #E6C8A0 100%);
  border-radius: var(--radius-xl);
  padding: 50rpx 40rpx;
  border: 2rpx solid var(--color-primary-dark);
  box-shadow: var(--shadow-primary);
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
  animation: slideUp var(--transition-normal);
}

/* 卡片背景装饰 */
.feature-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.feature-card:active {
  transform: translateY(-6rpx) scale(0.98);
  box-shadow: var(--shadow-lg);
}

.card-icon {
  font-size: 90rpx;
  text-align: center;
  margin-bottom: 25rpx;
  animation: breathe 3s ease-in-out infinite;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.1));
}

.card-title {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--color-primary-darker);
  text-align: center;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.card-desc {
  font-size: 28rpx;
  color: var(--color-primary-darker);
  text-align: center;
  opacity: 0.85;
  line-height: 1.5;
}

.admin-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #F5F5F5 100%);
  border: 2rpx solid var(--color-border);
  box-shadow: var(--shadow-md);
}

.admin-card .card-title {
  color: var(--color-primary-darker);
}

.admin-card .card-desc {
  color: var(--color-text-secondary);
}

/* 健康管理卡片 */
.health-card {
  background: linear-gradient(135deg, #FFE5E5 0%, #FFD4D4 100%);
  border: 2rpx solid #FFB3B3;
  box-shadow: 0 6rpx 16rpx rgba(255, 102, 102, 0.3);
}

.health-card .card-icon {
  animation: breathe 2s ease-in-out infinite;
}

.health-card .card-title {
  color: #D32F2F;
}

.health-card .card-desc {
  color: #C62828;
  opacity: 0.85;
}

.health-card:active {
  transform: translateY(-6rpx) scale(0.98);
  box-shadow: 0 8rpx 20rpx rgba(255, 102, 102, 0.4);
}

/* 用户信息 - 个性化增强 */
.user-info-section {
  background: var(--color-bg-light);
  border-radius: var(--radius-xl);
  padding: 35rpx 30rpx;
  box-shadow: var(--shadow-md);
  animation: scaleIn var(--transition-normal);
}

/* 信息完善提示 - 强化版 */
.info-reminder {
  background: linear-gradient(135deg, #FFF9F0 0%, #FFE6CC 100%);
  border: 3rpx solid var(--color-primary);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  animation: gentle-pulse 2s ease-in-out infinite;
  box-shadow: 0 4rpx 16rpx rgba(230, 200, 160, 0.3);
}

.reminder-icon {
  font-size: 48rpx;
  line-height: 1;
  animation: shake 3s ease-in-out infinite;
}

.reminder-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-primary-darker);
  font-weight: 600;
  line-height: 1.5;
}

/* 横向布局 */
.user-info-horizontal {
  display: flex;
  align-items: center;
  gap: 35rpx;
}

.avatar-btn {
  width: auto;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
  transition: all var(--transition-fast);
}

.avatar-btn::after {
  border: none;
}

.avatar-btn:active {
  transform: scale(0.95);
}

.user-avatar-large {
  width: 150rpx;
  height: 150rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-bg);
  border: 5rpx solid var(--color-primary);
  box-shadow: 0 6rpx 20rpx rgba(230, 200, 160, 0.4);
  transition: all var(--transition-fast);
}

.user-avatar-placeholder {
  width: 150rpx;
  height: 150rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: bold;
  color: var(--color-primary-darker);
  border: 5rpx solid var(--color-primary);
  box-shadow: 0 6rpx 20rpx rgba(230, 200, 160, 0.4);
  transition: all var(--transition-fast);
  animation: breathe 3s ease-in-out infinite;
}

.user-info-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.user-name-input-large {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--color-primary-darker);
  width: 100%;
  padding: 0;
  background: transparent;
  border-bottom: 3rpx solid var(--color-primary);
  padding-bottom: 12rpx;
  transition: all var(--transition-fast);
}

.user-name-input-large:focus {
  border-bottom-color: var(--color-accent);
}

.user-role-large {
  font-size: 30rpx;
  color: var(--color-text-gray);
  font-weight: 500;
  display: inline-block;
  padding: 6rpx 20rpx;
  background: linear-gradient(135deg, var(--color-primary-lighter) 0%, #FFE6CC 100%);
  border-radius: 30rpx;
  border: 2rpx solid var(--color-primary-light);
  width: fit-content;
}

.user-info-tip {
  margin-top: 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-gray);
  opacity: 0.8;
}
