<!-- pages/index/index.wxml -->
<view class="container index-container">
  <!-- 顶部欢迎区域 - 拼贴相册风格 -->
  <view class="welcome-section">
    <!-- 照片拼贴层 -->
    <view class="photo-collage">
      <!-- 照片1 - 左上角 -->
      <view class="photo-frame photo-1">
        <image class="photo-img" src="{{photos[0]}}" mode="aspectFill"></image>
      </view>
      <!-- 照片2 - 右上角 -->
      <view class="photo-frame photo-2">
        <image class="photo-img" src="{{photos[1]}}" mode="aspectFill"></image>
      </view>
      <!-- 照片3 - 左下角 -->
      <view class="photo-frame photo-3">
        <image class="photo-img" src="{{photos[2]}}" mode="aspectFill"></image>
      </view>
      <!-- 照片4 - 右下角 -->
      <view class="photo-frame photo-4">
        <image class="photo-img" src="{{photos[3]}}" mode="aspectFill"></image>
      </view>
    </view>

    <!-- 文字内容层 -->
    <view class="welcome-content">
      <view class="welcome-title">璐璐和曼丽家聚餐站</view>
      <view class="welcome-desc">亲爱的，来我家前先选好菜～我好提前准备，等你开吃！</view>
    </view>
  </view>

  <!-- 功能卡片 -->
  <view class="feature-cards">
    <!-- 点餐卡片 -->
    <view class="feature-card" bindtap="goToMenu">
      <view class="card-icon">🍽️</view>
      <view class="card-title">选你想吃的菜</view>
      <view class="card-desc">浏览菜单，选择您喜欢的菜品</view>
    </view>

    <!-- 我的任务卡片 -->
    <view class="feature-card" bindtap="goToOrderHistory">
      <view class="card-icon">📋</view>
      <view class="card-title">再看看合不合我的胃口</view>
      <view class="card-desc">查看投喂任务记录</view>
    </view>

    <!-- 管理后台卡片（仅管理员可见） -->
    <view class="feature-card admin-card" wx:if="{{isAdmin}}" bindtap="goToAdmin">
      <view class="card-icon">⚙️</view>
      <view class="card-title">主厨入口</view>
      <view class="card-desc">管理菜单、订单和用户</view>
    </view>
  </view>

  <!-- 用户信息 -->
  <view class="user-info-section">
    <!-- 提示完善信息（当用户信息为默认值时显示） -->
    <view wx:if="{{userInfo.nickname === '昵称' || !userInfo.avatar}}" class="info-reminder">
      <view class="reminder-icon">👋</view>
      <view class="reminder-text">点击下方头像和昵称，完善个人信息</view>
    </view>

    <!-- 横向布局 -->
    <view class="user-info-horizontal">
      <!-- 头像 -->
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{userInfo.avatar}}" class="user-avatar-large" src="{{userInfo.avatar}}" mode="aspectFill"></image>
        <view wx:else class="user-avatar-placeholder">{{userInfo.nickname ? userInfo.nickname.charAt(0) : '?'}}</view>
      </button>

      <!-- 昵称和角色 -->
      <view class="user-info-right">
        <input
          class="user-name-input-large"
          type="nickname"
          placeholder="点击输入昵称"
          value="{{userInfo.nickname || ''}}"
          bindblur="onNicknameBlur"
        />
        <view class="user-role-large">{{roleName}}</view>
      </view>
    </view>

    <view class="user-info-tip">点击头像和昵称可修改</view>
  </view>
</view>
