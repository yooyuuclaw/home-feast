<!-- pages/index/index.wxml -->
<view class="container index-container">
  <!-- 顶部欢迎区域 -->
  <view class="welcome-section">
    <view class="welcome-title">璐璐和曼丽家聚餐点餐站</view>
    <view class="welcome-desc">亲爱的，来我家前先选好菜～我好提前准备，等你开吃！</view>
  </view>

  <!-- 功能卡片 -->
  <view class="feature-cards">
    <!-- 点餐卡片 -->
    <view class="feature-card" bindtap="goToMenu">
      <view class="card-icon">🍽️</view>
      <view class="card-title">选你想吃的菜</view>
      <view class="card-desc">浏览菜单，选择您喜欢的菜品</view>
    </view>

    <!-- 我的订单卡片 -->
    <view class="feature-card" bindtap="goToOrderHistory">
      <view class="card-icon">📋</view>
      <view class="card-title">我点的菜</view>
      <view class="card-desc">查看历史订单记录</view>
    </view>

    <!-- 管理后台卡片（仅管理员可见） -->
    <view class="feature-card admin-card" wx:if="{{isAdmin}}" bindtap="goToAdmin">
      <view class="card-icon">⚙️</view>
      <view class="card-title">主厨入口</view>
      <view class="card-desc">管理菜单、订单和用户</view>
    </view>
  </view>

  <!-- 用户信息 -->
  <view class="user-info-section">
    <!-- 提示完善信息（当用户信息为默认值时显示） -->
    <view wx:if="{{userInfo.nickname === '昵称' || !userInfo.avatar}}" class="info-reminder">
      <view class="reminder-icon">👋</view>
      <view class="reminder-text">点击下方头像和昵称，完善个人信息</view>
    </view>

    <!-- 横向布局 -->
    <view class="user-info-horizontal">
      <!-- 头像 -->
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="user-avatar-large" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      </button>

      <!-- 昵称和角色 -->
      <view class="user-info-right">
        <input
          class="user-name-input-large"
          type="nickname"
          placeholder="点击输入昵称"
          value="{{userInfo.nickname || ''}}"
          bindblur="onNicknameBlur"
        />
        <view class="user-role-large">{{roleName}}</view>
      </view>
    </view>

    <view class="user-info-tip">点击头像和昵称可修改</view>
  </view>
</view>
