/* pages/cart/cart.wxss */
.cart-container {
  padding-bottom: 150rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

/* 进度指示器 */
.progress-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 30rpx;
  background: var(--color-bg-light);
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  animation: slideDown var(--transition-normal);
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: all var(--transition-fast);
}

/* 第一步可点击样式 */
.progress-step.completed {
  cursor: pointer;
}

.progress-step.completed:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.step-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-gray);
  border: 3rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--color-text-gray);
  transition: all var(--transition-normal);
}

.progress-step.completed .step-circle,
.progress-step.active .step-circle {
  background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
  border-color: var(--color-accent-dark);
  color: white;
  box-shadow: var(--shadow-accent);
}

.progress-step.active .step-circle {
  animation: pulse 2s ease-in-out infinite;
  transform: scale(1.1);
}

.step-label {
  font-size: 24rpx;
  color: var(--color-text-gray);
  font-weight: 500;
}

.progress-step.completed .step-label,
.progress-step.active .step-label {
  color: var(--color-accent-dark);
  font-weight: bold;
}

.progress-line {
  width: 80rpx;
  height: 3rpx;
  background: var(--color-border);
  margin: 0 10rpx;
  margin-bottom: 40rpx;
  transition: all var(--transition-normal);
}

.progress-line.completed {
  background: linear-gradient(90deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
}

/* 空购物车 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 0;
  animation: fadeIn var(--transition-normal);
}

.empty-icon {
  font-size: 150rpx;
  margin-bottom: 30rpx;
  opacity: 0.3;
  animation: breathe 3s ease-in-out infinite;
}

.empty-text {
  font-size: 32rpx;
  color: var(--color-text-gray);
  margin-bottom: 50rpx;
}

.go-menu-btn {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: var(--color-primary-darker);
  border-radius: 40rpx;
  padding: 24rpx 60rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: 2rpx solid var(--color-primary-dark);
  box-shadow: var(--shadow-primary);
  transition: all var(--transition-fast);
}

.go-menu-btn:active {
  transform: translateY(2rpx) scale(0.95);
  box-shadow: var(--shadow-sm);
}

/* 购物车列表 - 渐变边框升级 */
.cart-list {
  padding: 20rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background: var(--color-bg-light);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-md);
  border: 2rpx solid transparent;
  background-clip: padding-box;
  position: relative;
  animation: slideUp var(--transition-normal);
  transition: all var(--transition-fast);
}

/* 渐变边框效果 */
.cart-item::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: var(--radius-lg);
  padding: 2rpx;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-accent-light));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  opacity: 0;
  transition: all var(--transition-fast);
}

.cart-item:active::before {
  opacity: 1;
}

.cart-item:active {
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-lg);
}

.item-image-wrapper {
  width: 130rpx;
  height: 130rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-bg-gray);
  margin-right: 24rpx;
  box-shadow: var(--shadow-sm);
}

.item-image {
  width: 100%;
  height: 100%;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text-primary);
  margin-bottom: 10rpx;
}

.item-category {
  font-size: 24rpx;
  color: var(--color-text-gray);
}

/* 数量控制 - 升级版 */
.item-quantity {
  display: flex;
  align-items: center;
  background: var(--color-bg-gray);
  border-radius: 40rpx;
  padding: 10rpx;
  gap: 4rpx;
  position: relative;
  z-index: 10;
}

.quantity-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  border-radius: var(--radius-full);
  font-size: 36rpx;
  color: var(--color-primary-darker);
  font-weight: bold;
  border: 2rpx solid var(--color-primary-dark);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-fast);
  position: relative;
  z-index: 11;
  pointer-events: auto;
}

.quantity-btn:active {
  transform: scale(0.9);
  box-shadow: none;
}

.quantity-num {
  min-width: 70rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text-primary);
}

/* 聚餐日显示区域 - 橙色渐变升级 */
.gathering-section {
  margin: 20rpx;
  animation: slideUp var(--transition-normal);
}

.gathering-display {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, var(--color-accent-light) 0%, #FFE0B2 50%, var(--color-primary-light) 100%);
  padding: 28rpx;
  border-radius: var(--radius-lg);
  border: 3rpx solid var(--color-accent);
  box-shadow: var(--shadow-accent);
  position: relative;
  overflow: hidden;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.gathering-display:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

/* 装饰性背景 */
.gathering-display::before {
  content: '';
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 150rpx;
  height: 150rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.4) 0%, transparent 70%);
  border-radius: var(--radius-full);
  pointer-events: none;
}

.calendar-icon {
  font-size: 48rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
  animation: breathe 3s ease-in-out infinite;
}

.gathering-text {
  flex: 1;
  position: relative;
  z-index: 1;
}

.gathering-name {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-primary-darker);
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 4rpx rgba(255, 255, 255, 0.5);
}

.gathering-date {
  font-size: 26rpx;
  color: var(--color-primary-darker);
  opacity: 0.85;
  font-weight: 500;
}

/* 修改提示区域 */
.change-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: var(--radius-md);
  border: 2rpx dashed var(--color-accent);
  position: relative;
  z-index: 1;
}

.hint-text {
  font-size: 22rpx;
  color: var(--color-primary-darker);
  font-weight: 600;
  white-space: nowrap;
}

.hint-icon {
  font-size: 28rpx;
  animation: twinkle 2s ease-in-out infinite;
}

/* 闪烁动画 */
@keyframes twinkle {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.5;
    transform: scale(1.2);
  }
}

.gathering-empty {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  background: #FFF0F0;
  border-radius: var(--radius-md);
  border: 2rpx solid #FFD0D0;
  color: var(--color-error);
  font-size: 28rpx;
}

.warning-icon {
  font-size: 32rpx;
}

/* 备注区域 */
.notes-section {
  margin: 20rpx;
  animation: slideUp var(--transition-normal);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
}

.notes-input {
  width: 100%;
  min-height: 180rpx;
  background: var(--color-bg-light);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--color-border);
  transition: all var(--transition-fast);
}

.notes-input:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(230, 200, 160, 0.2);
}

/* 底部操作栏 - 渐变动画升级 */
.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, white 0%, rgba(255, 255, 255, 0.95) 90%, transparent 100%);
  padding: 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  backdrop-filter: blur(10rpx);
  animation: slideUp var(--transition-normal);
}

.footer-info {
  flex: 1;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.footer-info:active {
  transform: scale(0.96);
  opacity: 0.8;
}

.total-label {
  font-size: 34rpx;
  color: var(--color-text-primary);
  font-weight: bold;
}

/* 提交按钮 - 超级升级版 */
.submit-btn {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 50%, var(--color-accent) 100%);
  color: var(--color-primary-darker);
  border-radius: 40rpx;
  padding: 26rpx 64rpx;
  font-size: 34rpx;
  font-weight: bold;
  border: 2rpx solid var(--color-primary-dark);
  box-shadow: var(--shadow-primary);
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
  animation: gentle-pulse 2s ease-in-out infinite;
}

/* 按钮光泽流动效果 */
.submit-btn::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  animation: shine 3s linear infinite;
}

.submit-btn:active {
  transform: translateY(3rpx) scale(0.96);
  box-shadow: var(--shadow-sm);
  animation: none;
}

.submit-btn[disabled] {
  background: linear-gradient(135deg, #d0d0d0, #bbb);
  color: var(--color-text-gray);
  border: 2rpx solid #bbb;
  box-shadow: none;
  transform: none;
  animation: none;
  opacity: 0.6;
}
