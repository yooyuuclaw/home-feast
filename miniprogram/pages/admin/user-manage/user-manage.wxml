<!-- pages/admin/user-manage/user-manage.wxml -->
<view class="container user-manage-container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{users.length === 0}}" class="empty-state">
    <text>暂无用户</text>
  </view>

  <view wx:else class="user-list">
    <view wx:for="{{users}}" wx:key="_id" class="user-card">
      <image wx:if="{{item.avatar}}" class="user-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
      <view wx:else class="user-avatar-placeholder">{{item.nickname ? item.nickname.charAt(0) : '?'}}</view>

      <view class="user-info">
        <view class="user-name">{{item.nickname}}</view>
        <view class="user-role {{item.role}}">{{item.roleName}}</view>
      </view>

      <button
        class="role-btn"
        bindtap="changeRole"
        data-id="{{item._id}}"
        data-role="{{item.role}}">
        修改角色
      </button>
    </view>
  </view>
</view>
