<!-- pages/admin/backup-manage/backup-manage.wxml -->
<view class="container backup-container">
  <!-- 顶部标题栏 -->
  <view class="header-bar">
    <view class="header-title">💾 数据备份</view>
  </view>

  <!-- 备份操作区 -->
  <view class="backup-section card">
    <view class="section-icon">🛡️</view>
    <view class="section-title">数据库备份</view>
    <view class="section-desc">定期备份数据，保障数据安全</view>
    <button class="backup-btn" bindtap="backupDatabase">
      <text class="btn-icon">📦</text>
      <text>立即备份</text>
    </button>
  </view>

  <!-- 备份历史 -->
  <view class="history-section">
    <view class="history-header">
      <text class="history-icon">📋</text>
      <text class="history-title">备份历史</text>
    </view>

    <view wx:if="{{loading}}" class="loading">加载中...</view>

    <view wx:elif="{{backups.length === 0}}" class="empty-state">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无备份记录</text>
      <text class="empty-hint">点击上方按钮创建备份</text>
    </view>

    <view wx:else class="backup-list">
      <view wx:for="{{backups}}" wx:key="_id" class="backup-item card">
        <view class="backup-header">
          <view class="backup-icon">✓</view>
          <view class="backup-status">备份成功</view>
        </view>
        <view class="backup-info">
          <view class="info-row">
            <text class="info-label">📄 文件名称</text>
            <text class="info-value">{{item.fileName}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">⏰ 备份时间</text>
            <text class="info-value">{{formatTime(item.createTime)}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">👤 操作人</text>
            <text class="info-value">{{item.operator}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
