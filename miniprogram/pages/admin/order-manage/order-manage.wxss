/* pages/admin/order-manage/order-manage.wxss */
.order-manage-container {
  min-height: 100vh;
  background: #F9F9F9;
}

/* 顶部标题栏 */
.header-bar {
  background: linear-gradient(135deg, #FFB74D 0%, #FFA726 100%);
  padding: 25rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.2);
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.order-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
}

/* 状态筛选 */
.status-filter {
  display: flex;
  gap: 12rpx;
  padding: 15rpx;
  background: #F9F9F9;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 10rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
}

.filter-item.active {
  background: linear-gradient(135deg, #FFB74D, #FFA726);
  color: white;
  font-weight: bold;
  box-shadow: 0 4rpx 8rpx rgba(255, 152, 0, 0.3);
}

.filter-item:active {
  transform: scale(0.95);
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  padding: 15rpx;
}

.order-card {
  background: white;
  border-radius: 16rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
}

.order-card:active {
  transform: scale(0.99);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 15rpx;
  flex: 1;
}

.user-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: #f5f5f5;
  border: 3rpx solid #E6C8A0;
  flex-shrink: 0;
}

.user-avatar-placeholder {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E6C8A0, #D4B080);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #8B6E4E;
  border: 3rpx solid #E6C8A0;
  flex-shrink: 0;
}

.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.order-time {
  font-size: 22rpx;
  color: #999;
}

.order-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.order-status.pending {
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
  color: #F57C00;
  border: 1rpx solid #FFB74D;
}

.order-status.confirmed {
  background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
  color: #1976D2;
  border: 1rpx solid #64B5F6;
}

.order-status.completed {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  color: #388E3C;
  border: 1rpx solid #81C784;
}

/* 菜品列表 */
.order-dishes {
  background: #FAFAFA;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 15rpx;
}

.dishes-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.dish-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx dashed #E0E0E0;
}

.dish-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.dish-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
}

.dish-icon {
  font-size: 28rpx;
}

.dish-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.dish-count {
  font-size: 24rpx;
  color: #FF9800;
  font-weight: bold;
  padding: 4rpx 12rpx;
  background: #FFF3E0;
  border-radius: 12rpx;
}

/* 备注 */
.order-notes {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 24rpx;
  color: #666;
  padding: 15rpx;
  background: linear-gradient(135deg, #FFF9E6, #FFF3D9);
  border-radius: 12rpx;
  border-left: 3rpx solid #FFC107;
  margin-bottom: 15rpx;
}

.notes-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  line-height: 1.6;
}

.notes-text {
  flex: 1;
  line-height: 1.6;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.action-btn {
  flex: 1;
  min-width: 150rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
  padding: 18rpx 20rpx;
  border: none;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: scale(0.95);
}

.confirm-btn {
  background: linear-gradient(135deg, #42A5F5, #1976D2);
  color: white;
}

.complete-btn {
  background: linear-gradient(135deg, #66BB6A, #388E3C);
  color: white;
}

.delete-btn {
  background: #FFFFFF;
  color: #F44336;
  border: 1rpx solid #F44336 !important;
  box-shadow: 0 2rpx 6rpx rgba(244, 67, 54, 0.15);
}

.delete-btn:active {
  background: #FFEBEE;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 0;
  gap: 20rpx;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
