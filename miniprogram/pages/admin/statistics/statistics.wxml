<!-- pages/admin/statistics/statistics.wxml -->
<view class="container statistics-container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:else>
    <!-- 标签导航 -->
    <view class="tabs-nav">
      <view
        wx:for="{{tabs}}"
        wx:key="index"
        class="tab-item {{currentTab === index ? 'active' : ''}}"
        bindtap="onTabChange"
        data-index="{{index}}">
        {{item}}
      </view>
    </view>

    <!-- 标签内容 -->
    <view class="tabs-content">
      <!-- 订单统计 -->
      <view wx:if="{{currentTab === 0}}" class="tab-panel">
        <view class="stat-card card">
          <view class="stat-grid">
            <view class="stat-item">
              <view class="stat-value">{{orderStats.total}}</view>
              <view class="stat-label">总订单</view>
            </view>
            <view class="stat-item">
              <view class="stat-value" style="color: #faad14">{{orderStats.pending}}</view>
              <view class="stat-label">待处理</view>
            </view>
            <view class="stat-item">
              <view class="stat-value" style="color: #1890ff">{{orderStats.confirmed}}</view>
              <view class="stat-label">已确认</view>
            </view>
            <view class="stat-item">
              <view class="stat-value" style="color: #52c41a">{{orderStats.completed}}</view>
              <view class="stat-label">已完成</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 用户活动统计 -->
      <view wx:if="{{currentTab === 1}}" class="tab-panel">
        <view class="stat-card card">
          <view wx:if="{{userStats.length === 0}}" class="empty-tip">暂无用户数据</view>
          <view wx:else class="user-stat-list">
            <view wx:for="{{userStats}}" wx:key="_id" class="user-stat-item">
              <!-- 用户信息 -->
              <view class="user-stat-header">
                <image wx:if="{{item.avatar}}" class="user-stat-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
                <view wx:else class="user-stat-avatar-placeholder">{{item.nickname ? item.nickname.charAt(0) : '?'}}</view>
                <view class="user-stat-basic">
                  <view class="user-stat-name">{{item.nickname}}</view>
                  <view class="user-stat-role">{{item.roleName}}</view>
                </view>
              </view>

              <!-- 活动数据 -->
              <view class="user-stat-data">
                <view class="user-stat-row">
                  <view class="user-stat-label">首次上线：</view>
                  <view class="user-stat-value">{{item.createTimeFormatted}}</view>
                </view>
                <view class="user-stat-row">
                  <view class="user-stat-label">最后上线：</view>
                  <view class="user-stat-value">{{item.lastOnlineTimeFormatted}}</view>
                </view>
                <view class="user-stat-row">
                  <view class="user-stat-label">访问次数：</view>
                  <view class="user-stat-value">{{item.sessionCount}} 次</view>
                </view>
                <view class="user-stat-row">
                  <view class="user-stat-label">总在线时长：</view>
                  <view class="user-stat-value">{{item.totalDurationFormatted}}</view>
                </view>
                <view class="user-stat-row">
                  <view class="user-stat-label">平均时长：</view>
                  <view class="user-stat-value">{{item.avgDurationFormatted}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 热门菜品 -->
      <view wx:if="{{currentTab === 2}}" class="tab-panel">
        <view class="stat-card card">
          <view class="dish-stat-list">
            <view wx:for="{{dishStats}}" wx:key="dishId" class="dish-stat-item">
              <view class="dish-rank">{{index + 1}}</view>
              <view class="dish-stat-info">
                <view class="dish-stat-name">{{item.name}}</view>
                <view class="dish-stat-count">被点 {{item.totalQuantity}} 次</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
