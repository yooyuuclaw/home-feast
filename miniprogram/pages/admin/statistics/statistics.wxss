/* pages/admin/statistics/statistics.wxss */
.statistics-container {
  padding: 20rpx;
}

/* 标签导航 */
.tabs-nav {
  display: flex;
  background: white;
  border-radius: 16rpx;
  padding: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.3s ease;
  font-weight: 500;
}

.tab-item.active {
  background: linear-gradient(135deg, #E6C8A0 0%, #D4B080 100%);
  color: #8B6E4E;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(230, 200, 160, 0.3);
}

/* 标签内容 */
.tabs-content {
  min-height: 400rpx;
}

.tab-panel {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.stat-card {
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.dish-stat-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.dish-stat-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.dish-rank {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #07c160;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  margin-right: 20rpx;
}

.dish-stat-info {
  flex: 1;
}

.dish-stat-name {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.dish-stat-count {
  font-size: 24rpx;
  color: #999;
}

/* 用户活动统计 */
.user-stat-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.user-stat-item {
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #E6C8A0;
}

.user-stat-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #E6C8A0;
}

.user-stat-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 15rpx;
  background: #f5f5f5;
}

.user-stat-basic {
  flex: 1;
}

.user-stat-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #8B6E4E;
  margin-bottom: 5rpx;
}

.user-stat-role {
  font-size: 24rpx;
  color: #999;
}

.user-stat-data {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.user-stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
}

.user-stat-label {
  color: #666;
}

.user-stat-value {
  color: #333;
  font-weight: 500;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
  font-size: 26rpx;
}
