/* pages/admin/gathering-manage/gathering-manage.wxss */
.gathering-manage-container {
  min-height: 100vh;
  background: #F9F9F9;
}

/* 顶部标题栏 */
.header-bar {
  background: linear-gradient(135deg, #FFB74D 0%, #FFA726 100%);
  padding: 25rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.2);
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.add-btn {
  background: rgba(255, 255, 255, 0.95);
  color: #FF9800;
  border-radius: 30rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  border: none;
}

.add-btn::after {
  border: none;
}

.add-btn:active {
  transform: translateY(1rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.add-icon {
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1;
}

/* 聚餐日列表 */
.gathering-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  padding: 15rpx;
}

.gathering-card {
  background: white;
  border-radius: 16rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
}

.gathering-card:active {
  transform: scale(0.99);
}

/* 聚餐日头部 */
.gathering-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.theme-section {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
}

.theme-icon {
  font-size: 36rpx;
  line-height: 1;
}

.gathering-theme {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.date-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
  color: #F57C00;
  border: 1rpx solid #FFB74D;
  flex-shrink: 0;
}

/* 餐次信息 */
.meal-section {
  margin-bottom: 20rpx;
}

.meal-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.meal-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.meal-tag {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
  transition: all 0.2s ease;
}

.meal-tag.breakfast {
  background: linear-gradient(135deg, #FFF9E6, #FFF3D9);
  color: #FFA000;
  border: 1rpx solid #FFE082;
}

.meal-tag.lunch {
  background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
  color: #1976D2;
  border: 1rpx solid #64B5F6;
}

.meal-tag.dinner {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  color: #388E3C;
  border: 1rpx solid #81C784;
}

/* 操作按钮 */
.gathering-actions {
  display: flex;
  gap: 15rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.action-btn {
  flex: 1;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
  padding: 20rpx 20rpx;
  border: none;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: scale(0.95);
}

.edit-btn {
  background: linear-gradient(135deg, #42A5F5, #1976D2);
  color: white;
}

.delete-btn {
  background: #FFFFFF;
  color: #F44336;
  border: 1rpx solid #F44336 !important;
  box-shadow: 0 2rpx 6rpx rgba(244, 67, 54, 0.15);
}

.delete-btn:active {
  background: #FFEBEE;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 0;
  gap: 20rpx;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.empty-hint {
  font-size: 24rpx;
  color: #BBB;
}
