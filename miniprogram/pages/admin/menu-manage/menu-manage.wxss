/* pages/admin/menu-manage/menu-manage.wxss */
.menu-manage-container {
  padding: 0;
  background: #F9F9F9;
  min-height: 100vh;
}

/* 顶部操作栏 */
.header-bar {
  background: linear-gradient(135deg, #FFB74D 0%, #FFA726 100%);
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.2);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title-icon {
  font-size: 44rpx;
  line-height: 1;
}

.title-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.add-btn {
  background: rgba(255, 255, 255, 0.95);
  color: #FF9800;
  border-radius: 30rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  border: none;
}

.add-btn::after {
  border: none;
}

.add-icon {
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1;
}

/* 搜索栏 */
.search-bar {
  background: #FFFFFF;
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  position: sticky;
  top: 92rpx;
  z-index: 99;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  gap: 12rpx;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.search-input-wrapper:focus-within {
  background: #FFFFFF;
  border-color: #FFB74D;
  box-shadow: 0 0 0 4rpx rgba(255, 183, 77, 0.1);
}

.search-icon {
  font-size: 32rpx;
  line-height: 1;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 44rpx;
  line-height: 44rpx;
}

.clear-icon {
  font-size: 32rpx;
  color: #999;
  padding: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #E0E0E0;
  width: 44rpx;
  height: 44rpx;
  transition: all 0.2s ease;
  line-height: 1;
}

.clear-icon:active {
  background: #BDBDBD;
  transform: scale(0.9);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  gap: 20rpx;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}

.empty-hint {
  font-size: 24rpx;
  color: #BBB;
}

/* 菜品网格布局 */
.dish-grid {
  padding: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

/* 菜品卡片 */
.dish-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.dish-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 下架菜品的样式 */
.dish-card.offline {
  opacity: 0.6;
}

.dish-card.offline .dish-image {
  filter: grayscale(50%);
}

.dish-card.offline .dish-name,
.dish-card.offline .dish-category {
  color: #999;
}

/* 菜品图片 */
.dish-image-wrapper {
  position: relative;
  width: 100%;
  height: 280rpx;
  background: #F5F5F5;
}

.dish-image {
  width: 100%;
  height: 100%;
}

/* 状态标签 */
.status-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.status-badge.online {
  background: rgba(82, 196, 26, 0.9);
  color: #FFFFFF;
}

.status-badge.offline {
  background: rgba(189, 189, 189, 0.9);
  color: #FFFFFF;
}

/* 菜品信息 */
.dish-info {
  padding: 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-category {
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.category-icon {
  font-size: 24rpx;
}

/* 食材显示 */
.dish-ingredients {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #666;
}

.ingredients-label {
  font-size: 22rpx;
  line-height: 1;
}

.ingredients-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #558B2F;
  background: #F1F8E9;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

/* 操作按钮 */
.dish-actions {
  display: flex;
  padding: 12rpx;
  gap: 12rpx;
  justify-content: center;
}

.action-btn {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 50%;
  border: none;
  background: #F5F5F5;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: scale(0.9);
  background: #E8E8E8;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.12);
}

.btn-icon {
  font-size: 36rpx;
  line-height: 1;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}
