/* pages/admin/menu-manage/menu-manage.wxss */
.menu-manage-container {
  padding: 20rpx;
}

/* 添加按钮 */
.add-btn-wrapper {
  margin-bottom: 20rpx;
}

.add-btn {
  width: 100%;
  background: #07c160;
  color: white;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 28rpx;
  font-weight: bold;
}

/* 菜品列表 */
.dish-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dish-card {
  display: flex;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.dish-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
}

.dish-info {
  flex: 1;
}

.dish-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.dish-category {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.dish-status {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
}

.dish-status.online {
  background: #f6ffed;
  color: #52c41a;
}

.dish-status.offline {
  background: #fff1f0;
  color: #f5222d;
}

/* 操作按钮 */
.dish-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  justify-content: center;
  min-width: 100rpx;
}

.icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 12rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  transition: all 0.3s;
  cursor: pointer;
}

.icon-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.icon-btn .icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
  line-height: 1;
}

.icon-btn .btn-text {
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
}

.icon-btn.edit-btn {
  background: #e6f7ff;
}

.icon-btn.edit-btn .btn-text {
  color: #1890ff;
}

.icon-btn.toggle-btn {
  background: #fff7e6;
}

.icon-btn.toggle-btn .btn-text {
  color: #faad14;
}

.icon-btn.delete-btn {
  background: #fff1f0;
}

.icon-btn.delete-btn .btn-text {
  color: #f5222d;
}
