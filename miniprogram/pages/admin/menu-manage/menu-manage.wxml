<!-- pages/admin/menu-manage/menu-manage.wxml -->
<view class="container menu-manage-container">
  <!-- 顶部操作栏 -->
  <view class="header-bar">
    <view class="header-title">
      <text class="title-icon">🍽️</text>
      <text class="title-text">菜品管理</text>
    </view>
    <button class="add-btn" bindtap="addDish">
      <text class="add-icon">+</text>
      <text>添加菜品</text>
    </button>
  </view>

  <!-- 菜品列表 -->
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{dishes.length === 0}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无菜品</text>
    <text class="empty-hint">点击上方按钮添加菜品</text>
  </view>

  <view wx:else class="dish-grid">
    <view wx:for="{{dishes}}" wx:key="_id" class="dish-card {{item.status === 'offline' ? 'offline' : ''}}">
      <!-- 菜品图片 -->
      <view class="dish-image-wrapper">
        <image class="dish-image" src="{{item.image || '/images/default-dish.png'}}" mode="aspectFill"></image>
        <!-- 状态标签 -->
        <view class="status-badge {{item.status}}">
          {{item.status === 'online' ? '已上架' : '已下架'}}
        </view>
      </view>

      <!-- 菜品信息 -->
      <view class="dish-info">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-category">
          <text class="category-icon">{{getCategoryIcon(item.category)}}</text>
          <text>{{getCategoryName(item.category)}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="dish-actions">
        <button class="action-btn" bindtap="editDish" data-id="{{item._id}}">
          <text class="btn-icon">✏️</text>
        </button>
        <button class="action-btn" bindtap="toggleStatus" data-id="{{item._id}}" data-status="{{item.status}}">
          <text class="btn-icon">{{item.status === 'online' ? '📦' : '📤'}}</text>
        </button>
        <button class="action-btn" bindtap="deleteDish" data-id="{{item._id}}">
          <text class="btn-icon">🗑️</text>
        </button>
      </view>
    </view>
  </view>
</view>
