/* pages/menu/menu.wxss */
.menu-container {
  padding-bottom: 120rpx;
  background: #F9F9F9;
  min-height: 100vh;
}

/* 分类导航 */
.category-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #FFFFFF;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 2rpx rgba(238, 238, 238, 0.5);
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  padding: 0 20rpx;
}

.category-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 20rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #8B6E4E;
  background: #F9F9F9;
  border: 1rpx solid #E0E0E0;
  transition: all 0.2s ease;
}

.category-item.active {
  background: #E6C8A0;
  color: #8B6E4E;
  font-weight: bold;
  border: 1rpx solid #D4B080;
  box-shadow: 0 2rpx 4rpx rgba(212, 176, 128, 0.3);
}

/* 菜品列表 */
.dish-list {
  padding: 20rpx;
}

.dish-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.dish-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 2rpx rgba(238, 238, 238, 0.5);
}

.dish-image-wrapper {
  width: 100%;
  height: 280rpx;
  background: #F9F9F9;
}

.dish-image {
  width: 100%;
  height: 100%;
}

.dish-info {
  padding: 20rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #8B6E4E;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-category {
  font-size: 24rpx;
  color: #999;
}

.dish-action {
  padding: 0 20rpx 20rpx;
  display: flex;
  justify-content: center;
}

.add-btn {
  width: auto;
  min-width: 140rpx;
  background: #E6C8A0;
  color: #8B6E4E;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
  padding: 12rpx 32rpx;
  border: 1rpx solid #D4B080;
  box-shadow: 0 2rpx 4rpx rgba(212, 176, 128, 0.3);
  transition: all 0.2s ease;
}

.add-btn:active {
  transform: translateY(1rpx);
  box-shadow: 0 1rpx 2rpx rgba(212, 176, 128, 0.4);
}

/* 确认菜单按钮 */
.confirm-btn-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(249, 249, 249, 0.98) 0%, rgba(249, 249, 249, 0.95) 70%, transparent 100%);
  z-index: 1000;
  backdrop-filter: blur(10rpx);
}

.confirm-btn {
  background: linear-gradient(135deg, #E6C8A0 0%, #D4B080 100%);
  border-radius: 50rpx;
  padding: 24rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 110, 78, 0.3);
  transition: all 0.3s ease;
}

.confirm-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(139, 110, 78, 0.4);
}

.confirm-btn-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #52c41a;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.confirm-btn-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.confirm-btn-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B6E4E;
  letter-spacing: 2rpx;
}

.confirm-btn-count {
  font-size: 24rpx;
  color: #8B6E4E;
  opacity: 0.8;
}
