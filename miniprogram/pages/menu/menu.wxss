/* pages/menu/menu.wxss */
.menu-container {
  padding-bottom: 120rpx;
  background: #F9F9F9;
  min-height: 100vh;
}

/* 分类导航 */
.category-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #FFFFFF;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 2rpx rgba(238, 238, 238, 0.5);
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  padding: 0 20rpx;
}

.category-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 20rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #8B6E4E;
  background: #F9F9F9;
  border: 1rpx solid #E0E0E0;
  transition: all 0.2s ease;
}

.category-item.active {
  background: #E6C8A0;
  color: #8B6E4E;
  font-weight: bold;
  border: 1rpx solid #D4B080;
  box-shadow: 0 2rpx 4rpx rgba(212, 176, 128, 0.3);
}

/* 菜品列表 */
.dish-list {
  padding: 20rpx;
}

.dish-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.dish-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 2rpx rgba(238, 238, 238, 0.5);
}

.dish-image-wrapper {
  width: 100%;
  height: 280rpx;
  background: #F9F9F9;
}

.dish-image {
  width: 100%;
  height: 100%;
}

.dish-info {
  padding: 20rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #8B6E4E;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-category {
  font-size: 24rpx;
  color: #999;
}

.dish-action {
  padding: 0 20rpx 20rpx;
  display: flex;
  justify-content: center;
}

.add-btn {
  width: auto;
  min-width: 140rpx;
  background: #E6C8A0;
  color: #8B6E4E;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
  padding: 12rpx 32rpx;
  border: 1rpx solid #D4B080;
  box-shadow: 0 2rpx 4rpx rgba(212, 176, 128, 0.3);
  transition: all 0.2s ease;
}

.add-btn:active {
  transform: translateY(1rpx);
  box-shadow: 0 1rpx 2rpx rgba(212, 176, 128, 0.4);
}

/* 确认菜单按钮 */
.confirm-btn-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(249, 249, 249, 0.98) 0%, rgba(249, 249, 249, 0.95) 70%, transparent 100%);
  z-index: 1000;
  backdrop-filter: blur(10rpx);
}

.confirm-btn {
  background: linear-gradient(135deg, #E6C8A0 0%, #D4B080 100%);
  border-radius: 50rpx;
  padding: 24rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 110, 78, 0.3);
  transition: all 0.3s ease;
}

.confirm-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(139, 110, 78, 0.4);
}

.confirm-btn-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #52c41a;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.confirm-btn-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.confirm-btn-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B6E4E;
  letter-spacing: 2rpx;
}

.confirm-btn-count {
  font-size: 24rpx;
  color: #8B6E4E;
  opacity: 0.8;
}

/* 聚餐日选择横幅 */
.gathering-banner {
  background: linear-gradient(135deg, #FFB74D 0%, #FFA726 100%);
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 6rpx 16rpx rgba(255, 152, 0, 0.3);
  position: relative;
  overflow: hidden;
}

.gathering-banner::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 100%);
  pointer-events: none;
}

.gathering-banner-content {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.gathering-no-permission {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.lock-icon {
  font-size: 36rpx;
}

.permission-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.gathering-selected {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.calendar-icon {
  font-size: 48rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.gathering-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.gathering-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.gathering-subtitle {
  font-size: 24rpx;
  color: #FFFFFF;
  opacity: 0.9;
}

.switch-hint {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.25);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.switch-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.arrow-icon {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.gathering-empty {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.warning-icon {
  font-size: 36rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8B6E4E;
}

.arrow-icon {
  font-size: 48rpx;
  color: #8B6E4E;
  opacity: 0.6;
}

/* 菜品提示区域 */
.dishes-hint {
  background: #FFFFFF;
  padding: 16rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.hint-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.hint-icon {
  font-size: 28rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 其他人已点的菜品样式 */
.others-dish {
  opacity: 0.7;
  position: relative;
}

.others-dish .dish-card {
  background: #F5F5F5;
}

.others-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background: rgba(139, 110, 78, 0.9);
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
  backdrop-filter: blur(10rpx);
}

.others-badge-text {
  font-size: 22rpx;
  color: #FFF;
  font-weight: bold;
}

.others-add-btn {
  background: #D0D0D0;
  border-color: #BBB;
  color: #888;
}

/* 我自己已点的菜品样式 */
.my-dish {
  position: relative;
}

.my-dish .dish-card {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border: 2rpx solid #42A5F5;
  box-shadow: 0 4rpx 12rpx rgba(66, 165, 245, 0.25);
}

.my-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background: rgba(25, 118, 210, 0.95);
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 2rpx 6rpx rgba(25, 118, 210, 0.3);
}

.my-badge-text {
  font-size: 22rpx;
  color: #FFF;
  font-weight: bold;
}

.my-add-btn {
  background: linear-gradient(135deg, #42A5F5 0%, #1976D2 100%);
  border-color: #1976D2;
  color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(25, 118, 210, 0.3);
}

.my-add-btn:active {
  background: linear-gradient(135deg, #1976D2 0%, #1565C0 100%);
}

/* 聚餐日选择器弹窗 */
.gathering-picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2000;
}

.modal-mask {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  width: 100%;
  max-height: 60vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
}

.modal-header {
  padding: 30rpx;
  text-align: center;
  border-bottom: 1rpx solid #E0E0E0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B6E4E;
}

.gathering-picker-list {
  max-height: 50vh;
  overflow-y: auto;
  padding: 20rpx 0;
}

.gathering-picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.gathering-picker-item.selected {
  background: #FFF9F0;
}

.gathering-picker-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.gathering-picker-item.selected .gathering-picker-text {
  color: #8B6E4E;
  font-weight: bold;
}

.check-icon {
  font-size: 36rpx;
  color: #E6C8A0;
  margin-left: 20rpx;
}
