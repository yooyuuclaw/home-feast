/* pages/menu/menu.wxss */
.menu-container {
  padding-bottom: 180rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

/* 搜索框 */
.search-bar {
  background: var(--color-bg-light);
  padding: 20rpx 30rpx;
  box-shadow: var(--shadow-sm);
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: var(--color-bg-gray);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  gap: 12rpx;
  transition: all var(--transition-normal);
}

.search-input-wrapper:focus-within {
  background: var(--color-bg-light);
  box-shadow: 0 0 0 2rpx var(--color-primary);
}

.search-icon {
  font-size: 32rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.clear-icon {
  font-size: 32rpx;
  color: var(--color-text-gray);
  padding: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background: var(--color-border);
  width: 40rpx;
  height: 40rpx;
  transition: all var(--transition-fast);
}

.clear-icon:active {
  background: #D0D0D0;
  transform: scale(0.9);
}

/* 分类导航 */
.category-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--color-bg-light);
  padding: 20rpx 0;
  box-shadow: var(--shadow-sm);
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  padding: 0 20rpx;
}

.category-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 20rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: var(--color-primary-darker);
  background: var(--color-bg);
  border: 1rpx solid var(--color-border);
  transition: all var(--transition-fast);
}

.category-item.active {
  background: var(--color-primary);
  color: var(--color-primary-darker);
  font-weight: bold;
  border: 1rpx solid var(--color-primary-dark);
  box-shadow: var(--shadow-primary);
  transform: scale(1.05);
}

/* 菜品列表 */
.dish-list {
  padding: 20rpx;
}

.dish-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

/* 菜品卡片 - 升级版 */
.dish-card {
  background: var(--color-bg-light);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  transition: all var(--transition-normal);
  animation: fadeIn var(--transition-normal);
}

.dish-card:active {
  transform: translateY(-8rpx);
  box-shadow: var(--shadow-lg);
}

/* 已点过的菜品 */
.ordered-dish .dish-card {
  background: var(--color-bg-gray);
}

.ordered-dish .dish-image {
  opacity: 0.6;
  filter: grayscale(30%);
}

.dish-image-wrapper {
  width: 100%;
  height: 300rpx;
  background: var(--color-bg);
  position: relative;
  overflow: hidden;
}

/* 图片增强效果 */
.dish-image-wrapper::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.15), transparent);
  pointer-events: none;
}

.dish-image {
  width: 100%;
  height: 100%;
  transition: all var(--transition-normal);
}

.dish-card:active .dish-image {
  transform: scale(1.05);
}

/* 订单人列表 */
.order-list {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  max-width: 50%;
}

.order-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

.others-order {
  background: rgba(139, 110, 78, 0.92);
}

.my-order {
  background: rgba(25, 118, 210, 0.92);
}

/* 待提交订单的脉冲动画 */
.pending-order {
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.6;
  }
}

.order-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  background: #FFFFFF;
}

.order-avatar-placeholder {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  background: linear-gradient(135deg, #E6C8A0, #D4B080);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
  color: #8B6E4E;
  flex-shrink: 0;
}

.order-count {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: bold;
  white-space: nowrap;
}

.dish-info {
  padding: 22rpx 20rpx;
}

.dish-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-primary-darker);
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  position: relative;
}

/* 菜品名下划线装饰 */
.dish-name::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 0;
  width: 60rpx;
  height: 3rpx;
  background: linear-gradient(90deg, var(--color-accent), transparent);
  border-radius: 2rpx;
}

.dish-category {
  font-size: 24rpx;
  color: var(--color-text-gray);
}

.dish-action {
  padding: 0 20rpx 20rpx;
  display: flex;
  justify-content: center;
}

/* 加入按钮 - 渐变升级 */
.add-btn {
  width: auto;
  min-width: 150rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: var(--color-primary-darker);
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  padding: 14rpx 36rpx;
  border: 2rpx solid var(--color-primary-dark);
  box-shadow: var(--shadow-primary);
  transition: all var(--transition-fast);
  position: relative;
  overflow: hidden;
}

/* 按钮光泽效果 */
.add-btn::before {
  content: '✨';
  position: absolute;
  left: 12rpx;
  font-size: 20rpx;
  opacity: 0.8;
}

.add-btn:active {
  transform: translateY(2rpx) scale(0.95);
  box-shadow: var(--shadow-sm);
}

/* 确认菜单按钮 - 增强版 */
.confirm-btn-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(249, 249, 249, 0.98) 0%, rgba(249, 249, 249, 0.95) 70%, transparent 100%);
  z-index: 1000;
  backdrop-filter: blur(10rpx);
  animation: slideUp var(--transition-normal);
}

.confirm-btn {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 50%, var(--color-accent) 100%);
  border-radius: 50rpx;
  padding: 28rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  box-shadow: var(--shadow-primary);
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
  animation: gentle-pulse 2s ease-in-out infinite;
}

/* 按钮渐变流动效果 */
.confirm-btn::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  animation: shine 3s linear infinite;
}

@keyframes shine {
  0% {
    transform: translateX(-100%) translateY(-100%) rotate(45deg);
  }
  100% {
    transform: translateX(100%) translateY(100%) rotate(45deg);
  }
}

.confirm-btn:active {
  transform: translateY(4rpx) scale(0.98);
  box-shadow: var(--shadow-sm);
}

.confirm-btn-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: bold;
  color: var(--color-success);
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 1;
}

.confirm-btn-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  position: relative;
  z-index: 1;
}

.confirm-btn-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-primary-darker);
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(255, 255, 255, 0.5);
}

.confirm-btn-count {
  font-size: 26rpx;
  color: var(--color-primary-darker);
  opacity: 0.9;
}

/* 聚餐日选择横幅 */
.gathering-banner {
  background: linear-gradient(135deg, #FFB74D 0%, #FFA726 100%);
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 6rpx 16rpx rgba(255, 152, 0, 0.3);
  position: relative;
  overflow: hidden;
}

.gathering-banner::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 100%),
    radial-gradient(circle at 20% 30%, rgba(255, 235, 205, 0.6) 5rpx, transparent 5rpx),
    radial-gradient(circle at 60% 70%, rgba(255, 235, 205, 0.5) 4rpx, transparent 4rpx),
    radial-gradient(circle at 35% 85%, rgba(255, 235, 205, 0.6) 6rpx, transparent 6rpx),
    radial-gradient(circle at 80% 20%, rgba(255, 235, 205, 0.5) 5rpx, transparent 5rpx),
    radial-gradient(circle at 15% 65%, rgba(255, 235, 205, 0.6) 4rpx, transparent 4rpx),
    radial-gradient(circle at 70% 45%, rgba(255, 235, 205, 0.5) 6rpx, transparent 6rpx),
    radial-gradient(circle at 45% 15%, rgba(255, 235, 205, 0.6) 5rpx, transparent 5rpx),
    radial-gradient(circle at 90% 60%, rgba(255, 235, 205, 0.5) 4rpx, transparent 4rpx),
    radial-gradient(circle at 25% 50%, rgba(255, 235, 205, 0.6) 6rpx, transparent 6rpx),
    radial-gradient(circle at 55% 90%, rgba(255, 235, 205, 0.5) 5rpx, transparent 5rpx),
    radial-gradient(circle at 40% 60%, rgba(255, 235, 205, 0.4) 4rpx, transparent 4rpx),
    radial-gradient(circle at 75% 80%, rgba(255, 235, 205, 0.6) 6rpx, transparent 6rpx),
    radial-gradient(circle at 10% 40%, rgba(255, 235, 205, 0.5) 5rpx, transparent 5rpx),
    radial-gradient(circle at 85% 35%, rgba(255, 235, 205, 0.4) 4rpx, transparent 4rpx),
    radial-gradient(circle at 50% 25%, rgba(255, 235, 205, 0.6) 5rpx, transparent 5rpx);
  background-size:
    100% 100%,
    200rpx 200rpx,
    200rpx 200rpx,
    200rpx 200rpx,
    200rpx 200rpx,
    200rpx 200rpx,
    200rpx 200rpx,
    200rpx 200rpx,
    200rpx 200rpx,
    200rpx 200rpx,
    200rpx 200rpx,
    200rpx 200rpx,
    200rpx 200rpx,
    200rpx 200rpx,
    200rpx 200rpx,
    200rpx 200rpx;
  pointer-events: none;
  opacity: 0.7;
}

.gathering-banner-content {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.gathering-no-permission {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.lock-icon {
  font-size: 36rpx;
}

.permission-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.gathering-selected {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.calendar-icon {
  font-size: 48rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.gathering-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.gathering-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.gathering-subtitle {
  font-size: 24rpx;
  color: #FFFFFF;
  opacity: 0.9;
}

.switch-hint {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.25);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.switch-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.arrow-icon {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.gathering-empty {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.warning-icon {
  font-size: 36rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8B6E4E;
}

.arrow-icon {
  font-size: 48rpx;
  color: #8B6E4E;
  opacity: 0.6;
}

/* 聚餐日选择器弹窗 */
.gathering-picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2000;
}

.modal-mask {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  width: 100%;
  max-height: 60vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
}

.modal-header {
  padding: 30rpx;
  text-align: center;
  border-bottom: 1rpx solid #E0E0E0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B6E4E;
}

.gathering-picker-list {
  max-height: 50vh;
  overflow-y: auto;
  padding: 20rpx 0;
}

.gathering-picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.gathering-picker-item.selected {
  background: #FFF9F0;
}

.gathering-picker-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.gathering-picker-item.selected .gathering-picker-text {
  color: #8B6E4E;
  font-weight: bold;
}

.check-icon {
  font-size: 36rpx;
  color: #E6C8A0;
  margin-left: 20rpx;
}
