<!-- pages/menu/menu.wxml -->
<view class="container menu-container">
  <!-- 聚餐日选择横幅 -->
  <view class="gathering-banner" bindtap="openGatheringPicker">
    <view class="gathering-banner-content">
      <view wx:if="{{!canOrder}}" class="gathering-no-permission">
        <text class="lock-icon">🔒</text>
        <text class="permission-text">权限不足，需升级</text>
      </view>
      <view wx:elif="{{selectedGathering}}" class="gathering-selected">
        <text class="calendar-icon">📅</text>
        <view class="gathering-info">
          <text class="gathering-title">{{selectedGathering.theme || selectedGathering.displayText}}</text>
          <text class="gathering-subtitle">{{selectedGathering.dateLabel}} · 点击切换</text>
        </view>
      </view>
      <view wx:else class="gathering-empty">
        <text class="warning-icon">⚠️</text>
        <text class="empty-text">暂无可选聚餐日</text>
      </view>
    </view>
    <text class="arrow-icon">›</text>
  </view>

  <!-- 其他人已点的菜提示 -->
  <view wx:if="{{selectedGathering && Object.keys(othersOrdersMap).length > 0}}" class="others-orders-hint">
    <text class="hint-icon">👥</text>
    <text class="hint-text">灰色菜品为其他人已点（仅供参考，数量不可修改）</text>
  </view>

  <!-- 分类导航 -->
  <view class="category-nav">
    <scroll-view scroll-x class="category-scroll">
      <view class="category-list">
        <view
          class="category-item {{currentCategory === '' ? 'active' : ''}}"
          bindtap="selectCategory"
          data-category="">
          全部
        </view>
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="category-item {{currentCategory === item.id ? 'active' : ''}}"
          bindtap="selectCategory"
          data-category="{{item.id}}">
          {{item.icon}} {{item.name}}
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 菜品列表 -->
  <view class="dish-list">
    <view wx:if="{{loading}}" class="loading">加载中...</view>

    <view wx:elif="{{filteredDishes.length === 0}}" class="empty-state">
      <text>暂无菜品</text>
    </view>

    <view wx:else class="dish-grid">
      <view
        wx:for="{{filteredDishes}}"
        wx:key="_id"
        class="dish-card {{othersOrdersMap[item._id] ? 'others-dish' : ''}}"
        bindtap="showDishDetail"
        data-dish="{{item}}">
        <!-- 菜品图片 -->
        <view class="dish-image-wrapper">
          <image
            class="dish-image"
            src="{{item.image || '/images/default-dish.png'}}"
            mode="aspectFill">
          </image>
          <!-- 其他人已点标记 -->
          <view wx:if="{{othersOrdersMap[item._id]}}" class="others-badge">
            <text class="others-badge-text">{{othersOrdersMap[item._id]}}份</text>
          </view>
        </view>

        <!-- 菜品信息 -->
        <view class="dish-info">
          <view class="dish-name">{{item.name}}</view>
          <view class="dish-category">{{getCategoryName(item.category)}}</view>
        </view>

        <!-- 添加按钮 -->
        <view class="dish-action">
          <button
            class="add-btn {{othersOrdersMap[item._id] ? 'others-add-btn' : ''}}"
            catchtap="addToCart"
            data-dish="{{item}}">
            + 加入
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 确认菜单按钮 -->
  <view wx:if="{{cartCount > 0}}" class="confirm-btn-container" bindtap="goToCart">
    <view class="confirm-btn">
      <view class="confirm-btn-icon">✓</view>
      <view class="confirm-btn-text">
        <view class="confirm-btn-title">确认菜单</view>
        <view class="confirm-btn-count">已选 {{cartCount}} 道菜</view>
      </view>
    </view>
  </view>

  <!-- 聚餐日选择器弹窗 -->
  <view wx:if="{{showGatheringPicker}}" class="gathering-picker-modal">
    <view class="modal-mask" bindtap="{{() => this.setData({showGatheringPicker: false})}}"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">选择聚餐日</text>
      </view>
      <picker
        mode="selector"
        range="{{gatheringDays}}"
        range-key="displayText"
        value="{{selectedGatheringIndex}}"
        bindchange="onGatheringChange">
        <view class="gathering-picker-list">
          <view
            wx:for="{{gatheringDays}}"
            wx:key="_id"
            class="gathering-picker-item {{selectedGatheringIndex === index ? 'selected' : ''}}">
            <text class="gathering-picker-text">{{item.displayText}}</text>
            <text wx:if="{{selectedGatheringIndex === index}}" class="check-icon">✓</text>
          </view>
        </view>
      </picker>
    </view>
  </view>
</view>
