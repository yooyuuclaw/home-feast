<!-- 健康数据 ECharts 图表组件 -->
<view class="health-chart-container">
  <view class="chart-header">
    <view class="chart-title-section">
      <text class="chart-icon">📈</text>
      <text class="chart-title">{{title}}</text>
    </view>
    <view class="time-range-selector">
      <text
        class="range-btn {{timeRange === '7' ? 'active' : ''}}"
        bindtap="changeTimeRange"
        data-range="7">近7天</text>
      <text
        class="range-btn {{timeRange === '30' ? 'active' : ''}}"
        bindtap="changeTimeRange"
        data-range="30">近30天</text>
      <text
        class="range-btn {{timeRange === '90' ? 'active' : ''}}"
        bindtap="changeTimeRange"
        data-range="90">近3月</text>
    </view>
  </view>

  <!-- 数据统计摘要 -->
  <view wx:if="{{stats.avg > 0}}" class="stats-summary">
    <view class="stat-item">
      <text class="stat-label">平均值</text>
      <text class="stat-value">{{stats.avg}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">最高值</text>
      <text class="stat-value high">{{stats.max}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">最低值</text>
      <text class="stat-value low">{{stats.min}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">趋势</text>
      <text class="stat-value trend-{{stats.trend}}">
        {{stats.trend === 'up' ? '↑ 上升' : stats.trend === 'down' ? '↓ 下降' : '→ 平稳'}}
      </text>
    </view>
  </view>

  <!-- ECharts 图表 -->
  <view class="chart-wrapper">
    <ec-canvas
      wx:if="{{chartData.length > 0}}"
      id="health-chart-{{chartId}}"
      canvas-id="health-chart-{{chartId}}"
      ec="{{ ec }}"
      class="echarts-canvas">
    </ec-canvas>

    <view wx:else class="chart-empty">
      <text class="empty-icon">📊</text>
      <text class="empty-text">暂无{{title}}数据</text>
      <text class="empty-hint">添加记录后即可查看趋势图</text>
    </view>
  </view>
</view>
