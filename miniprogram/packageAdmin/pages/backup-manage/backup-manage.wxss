/* pages/admin/backup-manage/backup-manage.wxss */
.backup-container {
  min-height: 100vh;
  background: #F9F9F9;
}

/* 顶部标题栏 */
.header-bar {
  background: linear-gradient(135deg, #FFB74D 0%, #FFA726 100%);
  padding: 25rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.2);
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 备份操作区 */
.backup-section {
  margin: 15rpx;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border: 2rpx solid #64B5F6;
  text-align: center;
}

.section-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1976D2;
  margin-bottom: 10rpx;
}

.section-desc {
  font-size: 24rpx;
  color: #1976D2;
  margin-bottom: 30rpx;
  opacity: 0.8;
}

.backup-btn {
  width: 100%;
  background: linear-gradient(135deg, #42A5F5, #1976D2);
  color: white;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(25, 118, 210, 0.4);
  transition: all 0.3s ease;
}

.backup-btn::after {
  border: none;
}

.backup-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(25, 118, 210, 0.4);
}

.btn-icon {
  font-size: 36rpx;
  line-height: 1;
}

/* 备份历史 */
.history-section {
  padding: 15rpx;
}

.history-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 15rpx;
  padding: 0 5rpx;
}

.history-icon {
  font-size: 32rpx;
  line-height: 1;
}

.history-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

/* 备份列表 */
.backup-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.backup-item {
  background: white;
  border-radius: 16rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid #C8E6C9;
  transition: all 0.2s ease;
}

.backup-item:active {
  transform: scale(0.99);
}

.backup-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.backup-icon {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #66BB6A, #388E3C);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(56, 142, 60, 0.3);
}

.backup-status {
  font-size: 28rpx;
  font-weight: bold;
  color: #388E3C;
}

.backup-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  font-size: 26rpx;
  gap: 20rpx;
}

.info-label {
  color: #666;
  font-weight: 500;
  flex-shrink: 0;
}

.info-value {
  color: #333;
  font-weight: 600;
  text-align: right;
  word-break: break-all;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 0;
  gap: 20rpx;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.empty-hint {
  font-size: 24rpx;
  color: #BBB;
}
