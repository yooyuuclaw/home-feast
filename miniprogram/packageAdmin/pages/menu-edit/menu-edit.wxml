<!-- pages/admin/menu-edit/menu-edit.wxml -->
<view class="container menu-edit-container">
  <!-- 顶部标题栏 -->
  <view class="header-bar">
    <view class="header-title">{{isEdit ? '✏️ 编辑菜品' : '✨ 添加菜品'}}</view>
  </view>

  <view class="form-section card">
    <!-- 菜品图片 -->
    <view class="form-item">
      <view class="form-label">📸 菜品图片</view>
      <view class="image-upload" bindtap="uploadImage">
        <image wx:if="{{formData.image}}" class="dish-image-preview" src="{{formData.image}}" mode="aspectFill"></image>
        <view wx:else class="upload-placeholder">
          <text>点击上传美味图片</text>
        </view>
      </view>
    </view>

    <!-- 菜品名称 -->
    <view class="form-item">
      <view class="form-label">🍽️ 菜品名称</view>
      <input
        class="form-input"
        placeholder="请输入菜品名称，如：红烧肉"
        value="{{formData.name}}"
        bindinput="onNameInput"
      />
    </view>

    <!-- 菜品分类 -->
    <view class="form-item">
      <view class="form-label">📂 菜品分类</view>
      <picker
        mode="selector"
        range="{{categories}}"
        range-key="name"
        value="{{categoryIndex}}"
        bindchange="onCategoryChange">
        <view class="form-picker">
          {{categories[categoryIndex].name}}
        </view>
      </picker>
    </view>

    <!-- 主要食材 -->
    <view class="form-item">
      <view class="form-label">🥬 主要食材</view>
      <view class="ingredients-container">
        <view wx:for="{{formData.ingredients}}" wx:key="index" class="ingredient-item">
          <input
            class="ingredient-input"
            placeholder="如：牛肉、土豆等"
            value="{{item}}"
            data-index="{{index}}"
            bindinput="onIngredientInput"
          />
          <text class="ingredient-delete" data-index="{{index}}" bindtap="deleteIngredient">×</text>
        </view>
        <button class="add-ingredient-btn" bindtap="addIngredient">添加食材</button>
      </view>
    </view>

    <!-- 状态 -->
    <view class="form-item">
      <view class="form-label">⚡ 上架状态</view>
      <view style="display: flex; align-items: center;">
        <switch checked="{{formData.status === 'online'}}" bindchange="onStatusChange" color="#FF9800"/>
        <text class="status-text">{{formData.status === 'online' ? '✓ 已上架' : '✗ 已下架'}}</text>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="form-actions">
      <button class="submit-btn" bindtap="submitForm">{{isEdit ? '💾 保存修改' : '✨ 添加菜品'}}</button>
      <button class="cancel-btn" bindtap="cancel">取消</button>
    </view>
  </view>
</view>
