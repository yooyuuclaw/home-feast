/* pages/admin/audit-logs/audit-logs.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 统计卡片 */
.stats-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.stats-row {
  display: flex;
  justify-content: space-between;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.stat-item.critical .stat-value {
  color: #f56c6c;
}

.stat-item.warning .stat-value {
  color: #e6a23c;
}

.stat-item.failed .stat-value {
  color: #909399;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.filter-btn, .refresh-btn {
  background: white;
  padding: 20rpx 30rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.filter-btn {
  flex: 1;
  margin-right: 20rpx;
}

.arrow {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 日志列表 */
.logs-list {
  margin-bottom: 40rpx;
}

.log-item {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  border-left: 6rpx solid #ddd;
}

.log-item.level-critical {
  border-left-color: #f56c6c;
}

.log-item.level-warning {
  border-left-color: #e6a23c;
}

.log-item.level-info {
  border-left-color: #409eff;
}

.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.log-action {
  display: flex;
  align-items: center;
}

.success-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.success-icon.success {
  background: #67c23a;
  color: white;
}

.success-icon.failed {
  background: #f56c6c;
  color: white;
}

.action-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.log-time {
  font-size: 24rpx;
  color: #999;
}

.log-content {
  margin-bottom: 12rpx;
}

.log-message {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.log-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.level-badge {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  color: white;
}

.level-badge.level-critical {
  background: #f56c6c;
}

.level-badge.level-warning {
  background: #e6a23c;
}

.level-badge.level-info {
  background: #409eff;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
