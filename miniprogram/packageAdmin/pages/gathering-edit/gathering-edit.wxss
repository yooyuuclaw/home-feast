/* pages/admin/gathering-edit/gathering-edit.wxss */
.gathering-edit-container {
  padding: 20rpx;
  background: #F9F9F9;
  min-height: 100vh;
}

/* 表单卡片 */
.form-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 2rpx rgba(238, 238, 238, 0.5);
}

.form-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #8B6E4E;
  margin-bottom: 40rpx;
  text-align: center;
}

/* 表单项 */
.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  background: #F9F9F9;
}

.form-picker {
  width: 100%;
}

.picker-display {
  padding: 20rpx;
  border: 1rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  background: #F9F9F9;
}

/* 餐次复选框 */
.meal-checkboxes {
  display: flex;
  gap: 30rpx;
  flex-wrap: wrap;
}

.meal-checkbox {
  display: flex;
  align-items: center;
  padding: 15rpx 25rpx;
  background: #F9F9F9;
  border: 1rpx solid #E0E0E0;
  border-radius: 8rpx;
}

.meal-checkbox checkbox {
  margin-right: 10rpx;
}

.meal-label {
  font-size: 28rpx;
  color: #333;
}

/* 按钮 */
.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 50rpx;
}

.submit-btn {
  flex: 1;
  background: #E6C8A0;
  color: #8B6E4E;
  font-size: 30rpx;
  font-weight: bold;
  padding: 25rpx;
  border-radius: 40rpx;
  border: 1rpx solid #D4B080;
  box-shadow: 0 4rpx 6rpx rgba(212, 176, 128, 0.3);
  transition: all 0.2s ease;
  line-height: normal;
}

.submit-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 3rpx rgba(212, 176, 128, 0.4);
}

.cancel-btn {
  flex: 1;
  background: #fff;
  color: #999;
  font-size: 30rpx;
  padding: 25rpx;
  border-radius: 40rpx;
  border: 1rpx solid #E0E0E0;
  line-height: normal;
}

.cancel-btn:active {
  background: #F9F9F9;
}

/* 受邀访客部分 */
.guest-section {
  margin-top: 10rpx;
}

.guest-hint {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 20rpx;
  padding: 15rpx;
  background: #FFF9F0;
  border-left: 3rpx solid #E6C8A0;
  border-radius: 4rpx;
}

.selected-guests {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.selected-guest-item {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: #E6C8A0;
  border-radius: 30rpx;
  gap: 10rpx;
}

.selected-guest-name {
  font-size: 26rpx;
  color: #8B6E4E;
}

.remove-guest-btn {
  font-size: 36rpx;
  color: #8B6E4E;
  font-weight: bold;
  line-height: 1;
  padding: 0 5rpx;
}

.add-guest-btn {
  width: 100%;
  background: #fff;
  color: #8B6E4E;
  font-size: 28rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  border: 1rpx dashed #E6C8A0;
  line-height: normal;
}

.add-guest-btn:active {
  background: #F9F9F9;
}

/* 受邀访客选择弹窗 */
.guest-picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #E0E0E0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B6E4E;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 30rpx;
}

.no-guests {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 60rpx 0;
}

.guest-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.guest-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #F9F9F9;
  border-radius: 12rpx;
  gap: 20rpx;
}

.guest-item checkbox {
  margin: 0;
}

.guest-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #E0E0E0;
}

.guest-avatar-placeholder {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E6C8A0, #D4B080);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #8B6E4E;
  flex-shrink: 0;
}

.guest-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.modal-footer {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #E0E0E0;
  background: #fff;
}

.confirm-btn {
  width: 100%;
  background: #E6C8A0;
  color: #8B6E4E;
  font-size: 30rpx;
  font-weight: bold;
  padding: 25rpx;
  border-radius: 40rpx;
  border: 1rpx solid #D4B080;
  box-shadow: 0 4rpx 6rpx rgba(212, 176, 128, 0.3);
  line-height: normal;
}

.confirm-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 3rpx rgba(212, 176, 128, 0.4);
}
