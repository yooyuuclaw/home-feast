/* pages/admin/user-manage/user-manage.wxss */
.user-manage-container {
  min-height: 100vh;
  background: #F9F9F9;
  padding-bottom: 100rpx; /* 为分页栏留出空间 */
}

/* 顶部标题栏 */
.header-bar {
  background: linear-gradient(135deg, #FFB74D 0%, #FFA726 100%);
  padding: 25rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.2);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.user-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
}

/* 排序按钮 */
.sort-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.25);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.sort-icon {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.sort-text {
  font-size: 24rpx;
  color: #FFFFFF;
}

/* 2列网格布局 */
.user-grid {
  padding: 15rpx 15rpx 150rpx 15rpx; /* 底部增加更多空间，避免被分页栏遮挡 */
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 15rpx;
}

.user-card {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx 15rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  transition: all 0.3s ease;
  min-width: 0;
}

.user-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08);
}

.user-avatar-wrapper {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 5rpx;
}

.user-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: #f5f5f5;
  border: 3rpx solid #E6C8A0;
  flex-shrink: 0;
}

.user-avatar-placeholder {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E6C8A0, #D4B080);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #8B6E4E;
  border: 3rpx solid #E6C8A0;
  flex-shrink: 0;
}

.user-info {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.user-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  text-align: center;
  word-break: break-all;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.user-role-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  width: fit-content;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
}

.user-role-badge:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

/* 不同角色的徽章颜色 */
.user-role-badge.admin {
  background: linear-gradient(135deg, #FFE5CC, #FFD6A5);
  color: #D97706;
  border: 1rpx solid #FDB022;
}

.user-role-badge.chef {
  background: linear-gradient(135deg, #FFE5CC, #FFD6A5);
  color: #D97706;
  border: 1rpx solid #FDB022;
}

.user-role-badge.regular {
  background: linear-gradient(135deg, #E0F2FE, #BAE6FD);
  color: #0369A1;
  border: 1rpx solid #7DD3FC;
}

.user-role-badge.invited_guest {
  background: linear-gradient(135deg, #FCE7F3, #FBCFE8);
  color: #BE185D;
  border: 1rpx solid #F9A8D4;
}

.user-role-badge.uninvited_guest {
  background: linear-gradient(135deg, #F3F4F6, #E5E7EB);
  color: #6B7280;
  border: 1rpx solid #D1D5DB;
}

/* 分页栏 */
.pagination-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  z-index: 100;
}

.pagination-info {
  text-align: center;
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.pagination-buttons {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 15rpx;
}

.pagination-btn {
  background: linear-gradient(135deg, #FFB74D 0%, #FFA726 100%);
  color: white;
  border: none;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 6rpx rgba(255, 152, 0, 0.2);
}

.pagination-btn[disabled] {
  background: #E5E7EB;
  color: #9CA3AF;
  box-shadow: none;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
