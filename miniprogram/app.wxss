/**app.wxss**/

/* ============================================
   全局 CSS 变量 - 设计系统
   ============================================ */
page {
  /* 主色调 - 温暖棕色系 */
  --color-primary: #E6C8A0;
  --color-primary-dark: #D4B080;
  --color-primary-darker: #8B6E4E;
  --color-primary-light: #F5E5D0;
  --color-primary-lighter: #FFF9F0;

  /* 辅助色 - 橙色活力 */
  --color-accent: #FFB74D;
  --color-accent-dark: #FFA726;
  --color-accent-light: #FFE0B2;

  /* 功能色 */
  --color-success: #52c41a;
  --color-warning: #faad14;
  --color-error: #fa5151;
  --color-info: #1890ff;

  /* 中性色 */
  --color-bg: #F9F9F9;
  --color-bg-light: #FFFFFF;
  --color-bg-gray: #F5F5F5;
  --color-text-primary: #333333;
  --color-text-secondary: #666666;
  --color-text-gray: #999999;
  --color-border: #E0E0E0;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  --shadow-primary: 0 4rpx 16rpx rgba(139, 110, 78, 0.2);
  --shadow-accent: 0 6rpx 16rpx rgba(255, 152, 0, 0.3);

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --radius-full: 50%;

  /* 过渡 */
  --transition-fast: 0.2s ease;
  --transition-normal: 0.3s ease;
  --transition-slow: 0.5s ease;

  background-color: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

/* ============================================
   全局动画库
   ============================================ */

/* 淡入动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.fade-in {
  animation: fadeIn var(--transition-normal);
}

/* 从下滑入 */
@keyframes slideUp {
  from {
    transform: translateY(30rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.slide-up {
  animation: slideUp var(--transition-normal);
}

/* 从上滑入 */
@keyframes slideDown {
  from {
    transform: translateY(-30rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.slide-down {
  animation: slideDown var(--transition-normal);
}

/* 缩放进入 */
@keyframes scaleIn {
  from {
    transform: scale(0.9);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.scale-in {
  animation: scaleIn var(--transition-normal);
}

/* 呼吸动画 */
@keyframes breathe {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.05);
    opacity: 0.9;
  }
}

.breathe {
  animation: breathe 2s ease-in-out infinite;
}

/* 脉冲动画 */
@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.6;
  }
}

.pulse {
  animation: pulse 2s ease-in-out infinite;
}

/* 温和脉冲（已有，保持一致） */
@keyframes gentle-pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: var(--shadow-sm);
  }
  50% {
    transform: scale(1.02);
    box-shadow: var(--shadow-md);
  }
}

.gentle-pulse {
  animation: gentle-pulse 2s ease-in-out infinite;
}

/* 摇晃动画 */
@keyframes shake {
  0%, 100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-10rpx);
  }
  75% {
    transform: translateX(10rpx);
  }
}

.shake {
  animation: shake 0.5s ease-in-out;
}

/* 旋转动画 */
@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.rotate {
  animation: rotate 1s linear infinite;
}

/* 渐变移动动画（用于按钮等） */
@keyframes gradient-shift {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

.gradient-shift {
  background-size: 200% 200%;
  animation: gradient-shift 3s ease infinite;
}

/* ============================================
   通用交互类
   ============================================ */

/* 悬浮上浮效果 */
.hover-lift {
  transition: all var(--transition-fast);
}

.hover-lift:active {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-lg);
}

/* 按压缩小效果 */
.press-scale {
  transition: all var(--transition-fast);
}

.press-scale:active {
  transform: scale(0.95);
}

/* 水波纹效果容器 */
.ripple {
  position: relative;
  overflow: hidden;
}

.container {
  padding: 20rpx;
}

/* 通用按钮样式 */
.btn-primary {
  background-color: #07c160;
  color: white;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 24rpx;
}

.btn-secondary {
  background-color: #f0f0f0;
  color: #333;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 24rpx;
}

.btn-danger {
  background-color: #fa5151;
  color: white;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 24rpx;
}

/* 卡片样式 */
.card {
  background-color: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 列表项样式 */
.list-item {
  background-color: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 空状态样式 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 50rpx;
  color: #999;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  margin-right: 10rpx;
}

.tag-primary {
  background-color: #e6f7ff;
  color: #1890ff;
}

.tag-success {
  background-color: #f6ffed;
  color: #52c41a;
}

.tag-warning {
  background-color: #fffbe6;
  color: #faad14;
}

.tag-danger {
  background-color: #fff1f0;
  color: #f5222d;
}

/* 通用间距 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }
.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }

/* Flex 布局 */
.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

/* 文本样式 */
.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-gray {
  color: #999;
}

.text-small {
  font-size: 24rpx;
}

.text-large {
  font-size: 36rpx;
}

.text-bold {
  font-weight: bold;
}
